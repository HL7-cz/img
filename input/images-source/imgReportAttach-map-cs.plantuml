@startuml
hide circle
hide stereotype
hide members
hide methods
skinparam linetype ortho
skinparam class {
BackgroundColor<<LogicalModel>> #APPLICATION
BackgroundColor<<Profile>> #TECHNOLOGY
}
legend right
| <#APPLICATION>  Logický model |
| <#TECHNOLOGY>  Profil |
endlegend

class "Vizuální podoba dokumentu" <<LogicalModel>> [[StructureDefinition-PresentedFormCz.html]]

class "Přílohy" <<LogicalModel>> [[StructureDefinition-AttachmentsCz.html]]

class "cz-diagnosticReport.presentedForm" <<Profile>> [[https://build.fhir.org/ig/HL7-cz/img/StructureDefinition-cz-composition-imaging.html#acc]]
class "cz-attachment" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-cz-attachment.html]]

"Vizuální podoba dokumentu" -- "Přílohy"
"Vizuální podoba dokumentu" <|. "cz-diagnosticReport.presentedForm"
"Přílohy" <|. "cz-attachment"

"Vizuální podoba dokumentu" -r[hidden]-> "Přílohy"
"Vizuální podoba dokumentu" -d[hidden]-> "cz-diagnosticReport.presentedForm"
"Přílohy" -d[hidden]-> "cz-attachment"

@enduml
